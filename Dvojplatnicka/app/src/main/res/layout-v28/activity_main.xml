<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ExoPlayer View -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/custom_toolbar" />

    <FrameLayout
        android:id="@+id/mainView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:layout_below="@id/toolbar">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toTopOf="@id/mainView">

            <TextView
                android:id="@+id/menuText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textSize="32sp"
                android:fontFamily="@font/lobster"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                tools:ignore="NotSibling" />

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toEndOf="@id/menuText"
                app:layout_constraintTop_toTopOf="@id/menuText"
                android:contentDescription="obrazok"
                android:src="@drawable/dvojplatnicka_logo"
                android:visibility="visible">
            </ImageView>

            <!-- Button Grid Layout -->

            <GridLayout
                android:id="@+id/categoryGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:columnCount="3"
                android:gravity="center"
                android:rowCount="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menuText"
                >

                <Button
                    android:id="@+id/predjedla"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/transparent_bg_colored"
                    android:onClick="handleCategoryButtonClick"
                    android:tag="predjedlá"
                    android:text="🍜"
                    android:textSize="36sp" />

                <Button
                    android:id="@+id/hlavne_jedla"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/transparent_bg_colored"
                    android:onClick="handleCategoryButtonClick"
                    android:tag="hlavné jedlá"
                    android:text="🍝"
                    android:textSize="32sp" />

                <Button
                    android:id="@+id/dezerty"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/transparent_bg_colored"
                    android:onClick="handleCategoryButtonClick"
                    android:tag="dezerty"
                    android:text="🍰"
                    android:textSize="32sp" />
            </GridLayout>

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginTop="5dp"
                android:fillViewport="true"
                app:layout_constraintTop_toBottomOf="@id/categoryGrid"
                tools:layout_editor_absoluteX="-29dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:visibility="visible" />
            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <GridLayout
        android:id="@+id/shoppingListGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="1"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:layout_marginBottom="5dp">

        <Button
            android:id="@+id/remove_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✗"
            android:textSize="24sp"
            android:textColor="@android:color/holo_red_light"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:onClick="removeShoppingListClick"/>


        <Button
            android:id="@+id/shoppingListButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜"
            android:textSize="26sp"
            android:textColor="@android:color/holo_blue_dark"
            android:background="@android:color/transparent"
            android:onClick="shoppingListClick"
            android:alpha="0.7"/>

        <Button
            android:id="@+id/confirm_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒"
            android:textSize="24sp"
            android:textColor="@android:color/holo_green_light"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:onClick="confirmShoppingListClick"/>

    </GridLayout>

    <Button
        android:id="@+id/petButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:textSize="26sp"
        android:text="🦄"
        style="?android:attr/borderlessButtonStyle"/>


    <ImageButton
        android:id="@+id/likedButton"
        android:tag="obľúbené"
        android:layout_width="75dp"
        android:layout_height="65dp"
        android:contentDescription="@string/showliked"
        android:scaleType="fitCenter"
        android:src="@drawable/like_button"
        android:text=""
        android:layout_alignParentBottom="true"
        style="?android:attr/borderlessButtonStyle"/>

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:onClick="handleBackButtonClick"
        android:src="@drawable/back_button"
        android:scaleType="fitCenter"
        style="?android:attr/borderlessButtonStyle"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/settings_menu"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"
            android:text="Hlasitosť zvuku:"
            android:gravity="center"
            app:flow_horizontalAlign="center"
            app:layout_constraintBottom_toTopOf="@id/sound_bar">

        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:layout_marginBottom="20dp"
            android:text="♫"
            app:layout_constraintBottom_toBottomOf="@id/settings_menu"
            app:layout_constraintEnd_toStartOf="@id/sound_bar">

        </TextView>

        <SeekBar
            android:id="@+id/sound_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:thumbTint="?attr/colorPrimary"
            android:progressTint="?attr/colorPrimary"
            android:max="100"
            android:gravity="center_horizontal"
            app:layout_constraintBottom_toBottomOf="@id/settings_menu">

        </SeekBar>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="Veľkosť textu:"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/fontsize_picker"
            tools:ignore="MissingConstraints">

        </TextView>

        <NumberPicker
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:id="@+id/fontsize_picker"
            android:gravity="center_horizontal"
            android:layout_marginBottom="50dp"
            android:solidColor="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="@id/sound_bar"
            app:layout_constraintEnd_toEndOf="@id/sound_bar"
            app:layout_constraintBottom_toTopOf="@id/sound_bar">
        </NumberPicker>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginBottom="100dp"
            android:text="✑"
            android:gravity="center_horizontal"
            app:layout_constraintEnd_toStartOf="@id/fontsize_picker"
            app:layout_constraintBottom_toTopOf="@id/sound_bar">

        </TextView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="50dp"
            app:layout_constraintBottom_toTopOf="@id/fontsize_picker">

            <!-- Text above radio buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="50dp"
                app:layout_constraintBottom_toTopOf="@id/fontsize_picker">

                <!-- Text above radio buttons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="200dp"
                    android:text="Rozmestnenie receptov:"
                    android:textSize="18sp"
                    android:gravity="center"/>

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="1"
                    android:layout_margin="20dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center">

                    <!-- Image 1 -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/twoxtwo"
                        android:contentDescription="Image 1"
                        android:scaleType="centerCrop"/>

                    <!-- Image 2 -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/threexthree"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="Image 2"
                        android:scaleType="centerCrop"/>

                    <!-- Image 3 -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/fourxfour"
                        android:contentDescription="Image 3"
                        android:scaleType="centerCrop"/>

                </GridLayout>

                <!-- RadioGroup with horizontal orientation -->
                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">

                    <!-- First option -->
                    <RadioButton
                        android:id="@+id/radio_option_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:text="             " />

                    <!-- Second option -->
                    <RadioButton
                        android:id="@+id/radio_option_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:text="             " />

                    <!-- Third option -->
                    <RadioButton
                        android:id="@+id/radio_option_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:text="" />

                </RadioGroup>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:text="Tmavý/Svetlý mód:">

            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:text="☽"
                app:layout_constraintTop_toTopOf="@id/theme_switch"
                app:layout_constraintEnd_toStartOf="@id/theme_switch"
                tools:ignore="NotSibling">

            </TextView>

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:id="@+id/theme_switch"
                android:thumbTint="?attr/colorPrimaryVariant"
                android:trackTint="?attr/colorPrimary"
                app:layout_constraintBottom_toTopOf="@id/radioGroup"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="UseSwitchCompatOrMaterialXml">
            </Switch>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/shopping_menu"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone">

        <EditText
            android:id="@+id/shopping_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/android:textColor"
            android:textColorHint="?attr/android:textColor"
            android:layout_marginTop="48dp"
            android:hint="Tu si môžeš písať svoj nákupný zoznam">

        </EditText>

    </ScrollView>


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/item_menu"
        android:layout_marginTop="115dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:id="@+id/ingredients_menu">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/ingredients_text"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textSize="26sp"
                android:fontFamily="@font/dancing_script">
            </TextView>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/recipe_menu"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="80dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/recipe_text"
                android:textSize="26sp"
                android:fontFamily="@font/dancing_script">
            </TextView>

        </ScrollView>

    </RelativeLayout>

</RelativeLayout>


